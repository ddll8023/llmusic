{
	"name": "llmusic-electron",
	"productName": "LLMusic",
	"version": "1.0.0",
	"description": "LLMusic 本地音乐播放器",
	"main": "dist-ts/main.js",
	"private": true,
	"scripts": {
		"dev": "concurrently \"npm --prefix ../sys_vue run dev\" \"wait-on http://127.0.0.1:9753 && tsc && electron ./dist-ts\"",
		"dev:electron": "electron ./dist-ts",
		"dev-runner": "tsc && node ./dist-ts/dev-runner.js",
		"tsc": "tsc",
		"build:assets": "node -e \"console.log('build:assets: no assets to copy')\"",
		"tsc:watch": "tsc --watch",
		"type-check": "tsc --noEmit",
		"build": "npm --prefix ../sys_vue run build",
		"clean:backend": "node -e \"require('fs').rmSync('../backend/dist',{recursive:true,force:true})\"",
		"build:backend": "npm run clean:backend && uv run --directory ../backend --group build pyinstaller --noconfirm --clean --onefile --name backend --distpath dist entry.py",
		"clean:release": "node -e \"require('fs').rmSync('../release',{recursive:true,force:true})\"",
		"postinstall": "electron-builder install-app-deps",
		"pack": "node scripts/pack.cjs",
		"dist": "npm run build && npm run build:backend && npm run tsc && npm run pack",
		"dist:dir": "npm run build && npm run build:backend && npm run tsc && npm run pack -- --win --dir",
		"dist:mac": "npm run build && npm run build:backend && npm run tsc && npm run pack -- --mac",
		"dist:win": "npm run build && npm run build:backend && npm run tsc && npm run pack -- --win"
	},
	"dependencies": {
		"better-sqlite3": "^12.2.0",
		"ffmpeg-static": "^5.2.0",
		"ffprobe-static": "^3.1.0",
		"fluent-ffmpeg": "^2.1.3",
		"music-metadata": "^11.2.3",
		"node-id3": "^0.2.9",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.0.1",
		"concurrently": "^8.2.2",
		"electron": "^36.5.0",
		"electron-builder": "^26.0.12",
		"typescript": "^6.0.3",
		"wait-on": "^7.2.0"
	},
	"build": {
		"appId": "com.llmusic.desktop",
		"productName": "LLMusic",
		"directories": {
			"output": "../release"
		},
		"files": [
			"dist-ts/**/*"
		],
		"extraResources": [
			{
				"from": "../backend/dist",
				"to": "backend",
				"filter": [
					"backend*"
				]
			},
			{
				"from": "../sys_vue/src/assets/tray-icon.png",
				"to": "assets/tray-icon.png"
			},
			{
				"from": "../sys_vue/src/assets/llmusic-mark.png",
				"to": "assets/app-icon.png"
			},
			{
				"from": "../sys_vue/dist",
				"to": "sys_vue/dist",
				"filter": [
					"**/*"
				]
			}
		],
		"asarUnpack": [
			"**/*.node",
			"**/node_modules/ffmpeg-static/**",
			"**/node_modules/ffprobe-static/**"
		],
		"fileAssociations": [
			{
				"ext": "mp3",
				"name": "MP3 Audio File",
				"description": "MP3 音频文件",
				"role": "Editor"
			},
			{
				"ext": "flac",
				"name": "FLAC Audio File",
				"description": "FLAC 无损音频文件",
				"role": "Editor"
			},
			{
				"ext": "wav",
				"name": "WAV Audio File",
				"description": "WAV 音频文件",
				"role": "Editor"
			},
			{
				"ext": "m4a",
				"name": "M4A Audio File",
				"description": "M4A 音频文件",
				"role": "Editor"
			},
			{
				"ext": "ogg",
				"name": "OGG Audio File",
				"description": "OGG 音频文件",
				"role": "Editor"
			},
			{
				"ext": "aac",
				"name": "AAC Audio File",
				"description": "AAC 音频文件",
				"role": "Editor"
			}
		],
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
		"win": {
			"target": [
				"nsis",
				"zip"
			],
			"icon": "build/icon.ico"
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"icon": "build/icon.icns"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "LLMusic"
		}
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"ffmpeg-static@5.3.0": true,
		"electron-winstaller@5.4.0": true,
		"electron@36.9.5": true
	}
}
